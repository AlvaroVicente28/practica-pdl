let int x = 10;
function void a( void ) {
    write("Hola mundo");
    if(1 == 1) read x;
    switch(3 - 1) {
        case 2: write("OK");
        default: write("Unreachable");
    }
}

function boolean es_par(int x) {
    return x % 2 == 0;
}

function int orden(int x, int current) {
    switch(x % 2) {
        case 0: return orden(x - 1, current - -1);
        case 1: return 1;
        default: write "Unreachable!";
    }
}

write (orden(25, 0));
